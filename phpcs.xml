<?xml version="1.0"?>
<ruleset name="LLMs Helper" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
	<description>Production code profile.</description>

	<file>./llms-helper.php</file>
	<file>./src</file>

	<rule ref="./phpcs.base.xml"/>

	<!-- Test code has its own profile, phpcs.tests.xml. -->
	<exclude-pattern>(?-i)*/tests/*</exclude-pattern>

	<rule ref="WordPress.WhiteSpace.ControlStructureSpacing">
		<properties>
			<property name="blank_line_check" value="true"/>
		</properties>
	</rule>

	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter"/>
</ruleset>
